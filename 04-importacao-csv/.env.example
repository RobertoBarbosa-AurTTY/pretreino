# Configurações de Importação
PASTA_IMPORTACAO=./data
ARQUIVO_ENTRADA=clientes.csv
DELIMITADOR=;
ENCODING=utf-8

# Configurações de Validação
VALIDAR_EMAIL=true
VALIDAR_CPF=true
VALIDAR_TELEFONE=true
CAMPOS_OBRIGATORIOS=nome,email,cpf

# Configurações de Erro
PASTA_ERROS=./data/erros
ARQUIVO_ERROS=erros-importacao.log
IGNORAR_ERROS=false

# Configurações de Output
PASTA_OUTPUT=./data/importados
ARQUIVO_VALIDOS=clientes-validos.json
ARQUIVO_INVALIDOS=clientes-invalidos.json

# Configurações de Logging
LOG_IMPORTACAO=true
LOG_DETALHADO=false
