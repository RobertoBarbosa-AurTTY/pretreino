# Configurações da API Mock
# IMPORTANTE: Inicie a mock API primeiro: cd ../mock-api && deno task dev
API_BASE_URL=http://localhost:8080

# Configurações de Coleta
INTERVALO_COLETA=5000
INTERVALO_AGGREGACAO=60000
RETENCAO_DIAS=7

# Configurações do Servidor
PORT=3001
HOST=0.0.0.0

# Configurações de Métricas
METRICAS_MAX_POR_REQ=100
METRICAS_MIN_INTERVALO=1000

# Configurações de Percentis
CALCULAR_P95=true
CALCULAR_P99=true
CALCULAR_MEDIA=true

# Configurações de Downsampling
DOWNSAMPLING_HABILITADO=true
DOWNSAMPLING_INTERVALO=3600000

# Configurações de Armazenamento
PASTA_DADOS=./data
ARQUIVO_METRICAS=metricas.json
ARQUIVO_AGGREGADO=metricas-agregadas.json

# Configurações de Exportação
EXPORTAR_JSON=true
EXPORTAR_CSV=false
PASTA_EXPORTACAO=./output

# Configurações de Dashboard
DASHBOARD_HABILITADO=true
DASHBOARD_AUTO_REFRESH=30000

# Configurações de Logging
LOG_METRICAS=true
LOG_AGGREGACAO=true
LOG_LEVEL=info
