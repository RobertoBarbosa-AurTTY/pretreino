# Configurações da API Mock
# IMPORTANTE: Inicie a mock API primeiro: cd ../mock-api && deno task dev
API_EXTERNA_URL=http://localhost:8080
API_EXTERNA_TIMEOUT=5000

# Configurações de Cache
CACHE_TTL=300
CACHE_MAX_ENTRIES=1000
CACHE_PERSISTIR=true
CACHE_PASTA=./data
CACHE_ARQUIVO=cache.json

# Configurações de LRU
CACHE_LRU_HABILITADO=true
CACHE_LRU_MAX_ACESSOS=100

# Configurações de Estatísticas
CACHE_STATS_HABILITADO=true
CACHE_STATS_INTERVALO=60000

# Configurações de Limpeza
CACHE_LIMPEZA_AUTOMATICA=true
CACHE_INTERVALO_LIMPEZA=300000

# Configurações de Logging
LOG_CACHE_HITS=true
LOG_CACHE_MISSES=true
LOG_LEVEL=info
