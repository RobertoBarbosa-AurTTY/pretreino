# Configurações de Validação
MODO=validar
QUANTIDADE_GERAR=100
ACEITAR_FORMATADO=true

# Configurações de Formatacao
SEPARADOR_CPF=.
TRACO_CPF=-
CPF_FORMATADO=true

# Configurações de Geração
GERAR_ALEATORIO=true
CPF_INICIAL=00000000000
CPF_FINAL=99999999999

# Configurações de Saída
PASTA_SAIDA=./data
ARQUIVO_VALIDOS=cpfs-validos.txt
ARQUIVO_INVALIDOS=cpfs-invalidos.txt
ARQUIVO_GERADOS=cpfs-gerados.txt

# Configurações de Validação Avançada
VALIDAR_TODOS_DIGITOS=true
REJEITAR_TODOS_IGUAIS=true
VALIDAR_REGRAS_RECEITA=true

# Configurações de Logging
LOG_VALIDACAO=true
LOG_GERACAO=true
LOG_DETALHADO=false
