# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meubanco
DB_USER=admin
DB_PASS=senha123

# Configurações de Backup
BACKUP_BUCKET=meu-bucket-backup
BACKUP_REGIAO=us-east-1
BACKUP_RETENCAO_DIAS=7
BACKUP_PASTA=./backups
BACKUP_COMPACTAR=true

# Configurações de Storage (AWS S3)
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key
AWS_DEFAULT_REGION=us-east-1

# Configurações de Storage (Azure Blob - opcional)
# AZURE_STORAGE_ACCOUNT=meuaccount
# AZURE_STORAGE_KEY=minha_key

# Configurações de Compressão
COMPRESSAO_TIPO=gzip
COMPRESSAO_NIVEL=6

# Configurações de Logging
LOG_BACKUP=true
LOG_UPLOAD=true
LOG_CLEANUP=true
PASTA_LOGS=./logs

# Configurações de Notificação
NOTIFICAR_SUCESSO=false
NOTIFICAR_FALHA=true
EMAIL_NOTIFICACAO=admin@exemplo.com
