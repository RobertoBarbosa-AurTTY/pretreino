# Configurações da Fila
MAX_WORKERS=3
MAX_TENTATIVAS=3
DELAY_RETRY=1000
TIMEOUT_PROCESSAMENTO=30000

# Configurações de Concorrência
CONCORRENCIA_MAXIMA=5
INTERVALO_PROCESSAMENTO=100

# Configurações de Tarefas
TAREFA_TIMEOUT=60000
TAREFA_MAX_TAMANHO=1048576

# Configurações de Persistencia
PERSISTIR_FILA=true
PASTA_DADOS=./data
ARQUIVO_FILA=fila-tarefas.json
ARQUIVO_HISTORICO=historico-tarefas.json

# Configurações de Monitoramento
MONITORAR_FILA=true
INTERVALO_MONITORAMENTO=5000
LOG_TAREFAS=true

# Configurações de Processadores
PROCESSADOR_EMAIL=true
PROCESSADOR_IMAGEM=true
PROCESSADOR_RELATORIO=true

# Configurações de Logging
LOG_LEVEL=info
LOG_WORKERS=true
LOG_ERROS=true
PASTA_LOGS=./logs
