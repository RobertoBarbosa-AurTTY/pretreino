# Configurações do Servidor
PORT=3000
HOST=0.0.0.0

# Configurações da API Mock
# IMPORTANTE: Inicie a mock API primeiro: cd ../mock-api && deno task dev
API_BASE_URL=http://localhost:8080
WEBHOOK_SECRET=seu_secret_aqui

# Configurações de Idempotência
IDEMPOTENCY_EXPIRATION=86400
IDEMPOTENCY_STORE=./data/idempotency.json

# Configurações de Banco de Dados
DATABASE_URL=./data/pagamentos.db
DATABASE_TYPE=sqlite

# Configurações de Logging
LOG_LEVEL=info
LOG_WEBHOOKS=true
LOG_PAGAMENTOS=true
PASTA_LOGS=./logs

# Configurações de Retry
MAX_TENTATIVAS=3
DELAY_RETRY=1000
