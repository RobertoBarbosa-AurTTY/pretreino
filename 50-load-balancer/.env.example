# Porta em que o load balancer escuta (src/index.ts)
PORT=8000

# Estratégia: roundRobin | leastConn | weighted | ipHash
LB_STRATEGY=roundRobin

# Intervalo entre health checks, em milissegundos
HEALTH_CHECK_INTERVAL=10000

# Backends no formato host:porta:peso, separados por vírgula
BACKENDS=localhost:3001:1,localhost:3002:1,localhost:3003:2
