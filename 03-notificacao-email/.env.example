# Configurações da API Mock
# IMPORTANTE: Inicie a mock API primeiro: cd ../mock-api && deno task dev
API_BASE_URL=http://localhost:8080

# Configurações de Email (alternativo à API)
EMAIL_REMETENTE=Sistema <noreply@exemplo.com>
EMAIL_NOME_REMETENTE=Sistema

# Configurações de Fila
FILA_MAX_TENTATIVAS=3
FILA_DELAY_RETRY=1000
FILA_TIMEOUT_ENVIO=30000

# Configurações de Template
PASTA_TEMPLATES=./src/templates
EXTENSAO_TEMPLATE=.html

# Configurações de Logging
LOG_ENVIO=true
LOG_ERROS=true
PASTA_LOGS=./logs
